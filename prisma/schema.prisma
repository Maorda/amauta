generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
}

model Remate {
  // Identificador único de MongoDB (_id / ObjectId)
  id                           String   @id @default(auto()) @map("_id") @db.ObjectId
  
  codigoRemate                 String   @unique
  convocatoria                 String
  tasacionDolares              Float
  precioBaseDolares            Float
  
  // Estructuras JSON dinámicas (Sunarp, PJ, etc.)
  jsonRemaju                   Json
  jsonSunarp                   Json
  inmuebles                    Json
  cronograma                   Json     @default("[]")
  expedienteDatosPoderJudicial Json     @default("{}")

  // Control de auditoría temporal
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  @@map("remates")
}